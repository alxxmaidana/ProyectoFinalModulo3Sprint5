<!-- Encabezado del dashobard -->
<div class="page-header">
  <div class="page-header-inner">
    <div>
      <h1 class="page-title">Tabla de países hispanohablantes de América</h1>
      <p class="page-subtitle">Administra los países hispanos de América. Agrega, edita y elimina paises de forma sencilla.</p>
    </div>
    <!-- Botón para renderizar el formulário de agregar -->
    <a href="/paises/agregar" class="btn btn--primary">+ Agregar País</a>
  </div>
</div>

<!-- Mensajes de confirmación si se agregó, editó o eliminó correctamente un país -->
<% if (mensaje) { %>
  <div class="alert alert--<%= tipoMensaje %>">
    <span class="alert-icon"><%= tipoMensaje === "exito" ? '✓' : 'ℹ' %></span>
    <%= mensaje %>
    <button class="alert-close" onclick="this.parentElement.remove()">×</button>
  </div>
<% } %>
<!-- !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! -->
<!-- Tabla de países con botónes para editar/eliminar -->
<!-- !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! -->
<% if (paises) { %>
  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th class="col-flag"></th>
          <th>Nombre</th>
          <th>Capital</th>
          <th>Subregión</th>
          <th>Fronteras</th>
          <th class="col-num">Área (km²)</th>
          <th class="col-num">Población</th>
          <th>Zonas Horarias</th>
          <th>Moneda</th>
          <th>Gini</th>
          <th class="col-actions">Acciones</th>
        </tr>
      </thead>
      <tbody>

        <% paises.forEach(pais => { %>
        <!-- data-id para poder acceder al _id del país -->
        <tr class="table-row" data-id="<%= pais._id %>"> 

          <!-- Bandera -->
          <td class="cell-flag">
            <% if (pais.bandera) { %>
              <!-- URL de bandera  -->
              <img src="<%= pais.bandera %>" alt="Bandera de <%= pais.nombre.comun %>" class="flag-img" />
            <% } else { %>
              <span class="flag-placeholder">—</span>
            <% } %>
          </td>

          <!-- Nombre -->
          <td>
            <span class="name-comun"><%= pais.nombre.comun %></span>
            <span class="name-oficial"><%= pais.nombre.oficial %></span>
          </td>

          <!-- Capital -->
          <td>
            <% if (pais.capital) { %>
              <%= pais.capital.join(', ') %>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>

          <!-- Subregión -->
          <td>
            <span class="badge"><%= pais.subregion %></span>
          </td>

          <!-- Fronteras -->
          <td>
            <% if (pais.fronteras && pais.fronteras.length) { %>
              <div class="tags">
                <% pais.fronteras.forEach(frontera => { %>
                  <span class="tag"><%= frontera %></span>
                <% }) %>
              </div>
            <% } else { %>
              <span class="text-muted">Sin fronteras</span>
            <% } %>
          </td>

          <!-- Área -->
          <td class="cell-num">
            <%= pais.area.toLocaleString('es-AR') %>
          </td>

          <!-- Población -->
          <td class="cell-num">
            <%= pais.poblacion.toLocaleString('es-AR') %>
          </td>

          <!-- Zonas Horarias -->
          <td>
            <div class="tags">
              <% pais.zonasHorarias.forEach(zonaHoraria => { %>
                <span class="tag tag--maono"><%= zonaHoraria %></span>
              <% }) %>
            </div>
          </td>

          <!-- Moneda -->
          <td>
            <span class="moneda-simbolo"><%= pais.moneda.simbolo %></span>
            <span class="moneda-nombre"><%= pais.moneda.nombre %></span>
          </td>

          <!-- Gini -->
          <td>
            <% if (pais.indiceGini && pais.indiceGini.valor) { %>
              <div class="gini-wrapper">
                <!-- Mostrar el valor con un decimal -->
                <span class="gini-valor"><%= pais.indiceGini.valor.toFixed(1) %></span>
                <span class="gini-anio"><%= pais.indiceGini.anio %></span>
              </div>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
          </td>
          <!-- Botónes con para editar/eliminar país -->
          <td class="cell-actions">
            <!-- Botón para hecer la patición GET para renderizar el formulario de edición, obteniendo y mandando su ID cómo parametro de ruta -->
            <a href="/paises/<%= pais._id %>/editar" class="btn-action btn-action--edit" title="Editar">
              Editar
            </a>
            <!-- Botón para eliminar el país, haciendo la petición DELETE mandando su id cómo parámeto y Sobreescribiendo el método POST por el método DELETE -->
            <form action="paises/<%= pais._id %>/eliminar?_method=DELETE" method="POST" class="form-inline" id="formDelete">
              <button type="submit" class="btn-action btn-action--delete" title="Eliminar">
                Eliminar
              </button>
            </form>
          </td>
        </tr>
        <% }) %>

      </tbody>
      <tfoot>
        <!-- Totales para poblacion, area y promedio de gini -->
          <td>
            <% if (totalArea) { %>
                  <span>Área de América: <%= totalArea.toLocaleString()%></span>
            <% } %>
          </td>
          <td>
            <% if (totalPoblacion) { %>
                  <span>Población total de América: <%= totalPoblacion.toLocaleString() %></span>
            <% } %>
      </tfoot>
    </table>
  </div>

<% } %>