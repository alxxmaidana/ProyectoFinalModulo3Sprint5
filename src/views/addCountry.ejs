<!-- Encabezado del fomulario -->
<div class="page-header">
    <div class="page-header-inner">
        <div>
            <h1 class="page-title">Agregar un nuevo País</h1>
            <p class="page-subtitle">
                Completa los campos del País. Los campos con <span class="required">*</span> son obligatórios.
            </p>
        </div>
    <a href="/paises" class="btn btn--ghost">← Volver</a>
</div>

<!-- Formulario -->
<div class="form-card">
    <form action="/paises/agregar" method="POST">
        <%- include("partials/form", {
            title: "Agregar País",
            pais,
            subregiones,
            zonasHorarias,
            banderas, 
            errores
        }) %>

        <div class="form-actions">
            <!-- Botón para cancelar y volver al dashobard -->
            <a href="/paises" class="btn btn--ghost">Cancelar</a>
            <!-- Botón para enviar el formulario  -->
            <button type="submit" class="btn btn--primary">
                Agregar país
            </button>
        </div>
    </form>
</div>
